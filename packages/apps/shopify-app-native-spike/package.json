{
  "name": "@shopify/shopify-app-native-spike",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./transport": {
      "types": "./dist/ts/transport.d.ts",
      "import": "./dist/esm/transport.mjs",
      "require": "./dist/cjs/transport.js"
    }
  },
  "scripts": {
    "build": "rollup --bundleConfigAsCjs -c && tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "test:ci": "pnpm test"
  },
  "dependencies": {}
}
